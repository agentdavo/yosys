read_verilog -sv mac_acc.sv
design -save pristine

# p <= p + a*b -> the DSP output register is p
design -load pristine
hierarchy -top running_acc
synth_nexus -family lifcl -top running_acc
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=REGISTER
select -assert-count 0 t:FD1P3*
select -assert-count 0 t:CCU2

# Same loop against the simulation models
design -load pristine
hierarchy -top running_acc
proc
rename running_acc gold
design -stash gold
design -load pristine
hierarchy -top running_acc
synth_nexus -family lifcl -noiopad -top running_acc
delete =A:blackbox
read_verilog +/lattice/cells_sim_nexus.v
hierarchy -top running_acc
proc
flatten
rename running_acc gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -make_assert -flatten gold gate equiv
hierarchy -top equiv
sat -tempinduct -prove-asserts -set-init-zero -maxsteps 8 -verify equiv

# Signed
design -load pristine
hierarchy -top acc_signed
synth_nexus -family lifcl -top acc_signed
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=REGISTER
select -assert-count 0 t:FD1P3*

# p <= p - a*b
design -load pristine
hierarchy -top acc_sub
synth_nexus -family lifcl -top acc_sub
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=REGISTER
select -assert-count 0 t:FD1P3*

# Sync reset and enable become RSTOUT and CEOUT
design -load pristine
hierarchy -top acc_rst_en
synth_nexus -family lifcl -top acc_rst_en
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=REGISTER
select -assert-count 0 t:FD1P3*

# 4-lane int8 dot accumulator
design -load pristine
hierarchy -top acc_dot4
synth_nexus -family lifcl -top acc_dot4
select -assert-count 1 t:MULTADDSUB9X9WIDE r:REGOUTPUT=REGISTER
select -assert-count 0 t:FD1P3*

# reject
# sum read outside the loop
design -load pristine
hierarchy -top acc_sum_used
synth_nexus -family lifcl -top acc_sum_used
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=BYPASS
select -assert-count 20 t:FD1P3*

# DSP register only resets to 0
design -load pristine
hierarchy -top acc_rst_one
synth_nexus -family lifcl -top acc_rst_one
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=BYPASS
select -assert-count 20 t:FD1P3*

# addend is not the accumulator
design -load pristine
hierarchy -top acc_other_reg
synth_nexus -family lifcl -top acc_other_reg
select -assert-count 1 t:MULTADDSUB18X18 r:REGOUTPUT=BYPASS
select -assert-count 40 t:FD1P3*
